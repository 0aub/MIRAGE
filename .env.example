# MIRAGE Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True

# Ports
UI_PORT=3000
API_PORT=8000

# LLM Provider API Keys (at least ONE is required for entity extraction)
# The system will auto-detect and use the first available provider
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here  # Claude
GOOGLE_API_KEY=your_google_api_key_here  # Gemini

# Note: Jina embeddings run locally via HuggingFace (no API key needed)

# Database Configuration
NEO4J_PASSWORD=password

# REFRAG Configuration
REFRAG_COMPRESSION_RATE=16
REFRAG_CACHE_SIZE=1000

# Processing Configuration
MAX_UPLOAD_SIZE=100
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
